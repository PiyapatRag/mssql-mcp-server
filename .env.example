# =============================================================================
# MSSQL MCP Server configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The server looks for a .env file in this order (first found wins):
#   1. Path in MSSQL_ENV_FILE (set this in your MCP client config if the
#      .env lives somewhere else)
#   2. .env in the current working directory
#   3. .env in the project root (next to package.json)
#
# Variables already set in the MCP client's "env" block always take
# precedence over values in this file.
#
# SECURITY: .env is git-ignored. Never commit real credentials.
# =============================================================================

# --- Connection --------------------------------------------------------------
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=YourDatabase
MSSQL_USER=mcp_readonly
MSSQL_PASSWORD=SecurePassword123!

# Windows (NTLM) authentication: uncomment and set your domain.
# When MSSQL_DOMAIN is set, MSSQL_USER / MSSQL_PASSWORD are used as
# domain credentials instead of SQL authentication.
# MSSQL_DOMAIN=YOURDOMAIN

# --- TLS ----------------------------------------------------------------------
# Encrypted by default; set to false only for local dev against an instance
# with no TLS certificate configured. Leave MSSQL_TRUST_CERT unset/false in
# production — "true" disables certificate validation (opens a MITM path).
MSSQL_ENCRYPT=true
MSSQL_TRUST_CERT=false

# Local dev alternative (unencrypted, e.g. a local Express/Developer instance
# with no cert): uncomment these two and comment out the pair above.
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_CERT=true

# --- Mode ----------------------------------------------------------------------
# true  (default) = read-only: only SELECT / WITH / safe DECLARE batches /
#                   whitelisted read-only EXEC are allowed.
# false           = write mode: INSERT/UPDATE/DELETE/DDL allowed, but
#                   server-level dangerous statements (xp_cmdshell,
#                   sp_configure, DROP/ALTER DATABASE, RESTORE, GRANT/DENY,
#                   login changes, SHUTDOWN, KILL, OPENROWSET) stay blocked.
MSSQL_READ_ONLY=true

# Comma-separated whitelist of stored procedures EXEC may call in read-only
# mode. Empty/unset disables EXEC entirely.
# MSSQL_ALLOWED_PROCEDURES=dbo.GetReport,dbo.GetCustomerSummary

# In write mode, dynamic SQL (sp_executesql, EXEC('...')) is blocked outright.
# It cannot be inspected statically, so allowing it would let any blocked
# statement through inside a string. Write mode also assumes the login has NO
# sysadmin / securityadmin / role-admin rights — the statement blocklist is a
# backstop, not the primary control.

# --- Audit & error reporting -----------------------------------------------------
# Every tool call is logged to STDERR as one JSON line (stdout is the MCP
# transport and is never written to). Query text is collapsed to one line and
# truncated to 500 chars. Set to false if a query's WHERE clause would put
# sensitive literals in your MCP client's server log.
MSSQL_AUDIT_LOG=true

# Driver errors name objects, procedures and line numbers, which turns a failing
# query into a schema oracle. By default the caller gets only the first line,
# capped at 300 chars, plus the SQL error number; the full error still goes to
# the stderr log. Set to true while debugging to pass the driver text through.
MSSQL_VERBOSE_ERRORS=false

# --- Tuning (optional) ---------------------------------------------------------
# MSSQL_REQUEST_TIMEOUT=30000
# MSSQL_POOL_MAX=10
