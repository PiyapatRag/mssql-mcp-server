{
  "name": "@piyapat/mssql-mcp-server",
  "version": "2.0.2",
  "description": "Secure, read-only MCP server for Microsoft SQL Server with performance monitoring",
  "main": "build/index.js",
  "bin": {
    "mssql-mcp-server": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "test:security": "npm run build && node scripts/security-validation.mjs",
    "audit": "npm audit --audit-level=high",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "mssql",
    "sql-server",
    "database",
    "model-context-protocol",
    "claude",
    "monitoring"
  ],
  "author": "PiyapatRag (https://github.com/PiyapatRag)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mssql": "^12.7.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PiyapatRag/mssql-mcp-server"
  }
}
